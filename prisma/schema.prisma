datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ANALYST
  OBSERVER
}

/// État de la demande d'accès d'un compte (inscription publique → validation ADMIN).
/// APPROVED = accès normal ; PENDING = demande en attente de validation ; REJECTED = demande refusée.
enum AccountStatus {
  APPROVED
  PENDING
  REJECTED
}

/// Cycle de vie d'un lien d'accès observateur (jeton projet). Le jeton brut n'est
/// jamais stocké : seul son hash (SHA-256) est persisté dans `ObserverAccessToken.tokenHash`.
enum ObserverTokenStatus {
  ACTIVE
  COMPLETED
  REVOKED
  EXPIRED
}

/// Cycle de vie d'une PARTIE (passe vidéo) au sein d'une session d'observation.
///
/// « Envoyer cette partie » ≠ « terminer la session » : une partie peut être
/// SUBMITTED (finalisée / verrouillée) alors que la session globale reste ACTIVE.
/// Seul « Envoyer tout » finalise la session et la passe à COMPLETED.
enum ObserverPartStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

/// STATUT ANALYTIQUE d'un observateur DANS UN PROJET (déclassement scientifique).
///
/// Un observateur EXCLUDED reste un utilisateur à part entière : son compte, ses
/// sessions, ses captures RAW et son historique sont INTÉGRALEMENT conservés. Seul
/// le MOTEUR ANALYTIQUE courant cesse de compter ses observations. Aucune donnée
/// n'est jamais supprimée pour obtenir ce comportement.
enum ObserverAnalysisStatus {
  INCLUDED
  EXCLUDED
}

/// État d'une DEMANDE de réactivation d'accès observateur.
///
/// L'observateur peut DEMANDER une réactivation (jamais la déclencher lui-même) ;
/// seul un ADMIN confirme (APPROVED) ou refuse (REJECTED). Le statut de la demande
/// est INDÉPENDANT du statut du jeton (`ObserverTokenStatus`).
enum ReactivationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String                        @id @default(uuid())
  email                 String                        @unique
  username              String?                       @unique // Pseudonyme d'analyse (login lisible)
  password              String
  role                  Role                          @default(OBSERVER)
  isActive              Boolean                       @default(true) // Compte désactivable par un administrateur
  /// État de la demande d'accès. APPROVED (défaut) : compte utilisable ; PENDING : demande
  /// d'inscription publique (rôle ANALYST) non encore validée par un ADMIN ; REJECTED : refusée.
  accountStatus         AccountStatus                 @default(APPROVED)
  /// ADMIN ayant validé la demande d'accès (null tant que non traitée / créée directement).
  approvedById          String?
  approvedBy            User?                         @relation("AccountApproval", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  anonymousId           String                        @unique @default(uuid())
  observations          Observation[]
  ownedProjects         Project[]                     @relation("ProjectOwner")
  observerInclusions    ProjectObserverInclusion[]    @relation("ObserverInclusionSubject")
  exclusionsDecided     ProjectObserverInclusion[]    @relation("ObserverExclusionDecidedBy")
  inclusionsDecided     ProjectObserverInclusion[]    @relation("ObserverInclusionDecidedBy")
  grantedAccess         ProjectAccess[]
  observerTokens        ObserverAccessToken[]
  approvedAccounts      User[]                        @relation("AccountApproval")
  reactivationDecisions ObserverReactivationRequest[] @relation("ReactivationDecisions")
  auditLogs             AuditLog[]
  notifications         Notification[]
  communications        Communication[]               @relation("CommunicationAuthor")
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @default(now()) @updatedAt
}

/// NOTIFICATION IN-APP d'un utilisateur (lecture seule pour son destinataire).
///
/// Un utilisateur ne consulte QUE ses propres notifications ; la lecture et le
/// marquage sont toujours vérifiés côté serveur (jamais un `userId` cible accepté
/// du client). `readAt` non nul = lue (READ), sinon UNREAD.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Type métier (ex. ACCOUNT_APPROVED, EXPERIENCE_SHARED, REACTIVATION_REQUESTED…).
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId])
}

/// Historique d'une CAMPAGNE de communication email (espace ADMIN).
///
/// Un envoi groupé = N emails INDIVIDUELS (un par destinataire). On ne conserve que
/// le RÉSUMÉ (auteur, objet, template, compteurs) — jamais le contenu ni les adresses
/// des destinataires (confidentialité, pas de données sensibles stockées).
model Communication {
  id             String   @id @default(uuid())
  authorId       String?
  author         User?    @relation("CommunicationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  subject        String
  /// Identifiant du template utilisé (`communicationTemplates.ts`) ; null = message libre.
  templateId     String?
  recipientCount Int
  successCount   Int
  failureCount   Int
  createdAt      DateTime @default(now())

  @@index([authorId])
  @@index([createdAt])
}

/// Journal d'audit (append-only) : trace « qui a fait quoi, sur quelle ressource, quand ».
/// Les lignes ne sont jamais modifiées ni supprimées par les utilisateurs normaux ;
/// seul un ADMIN peut les consulter (ou chaque utilisateur pour ses propres lignes).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // ex. LOGIN_SUCCESS, PROJECT_CREATED, EXPORT_GLOBAL…
  entityType String?
  entityId   String?
  /// Contexte non sensible (projectId, role, result…) — JAMAIS de secrets/passwords.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Project {
  id                 String                     @id @default(uuid())
  ownerId            String? // Créateur (ADMIN ou ANALYST) — null pour les projets hérités
  owner              User?                      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  videoUrl           String? // Chemin ou nom du fichier vidéo local (vidéo « générique » héritée)
  observationTypes   String[]                   @default([]) // Types d'observation configurables proposés aux observateurs (ex: « 100m oblique », « Faune détectée »)
  isArchived         Boolean                    @default(false)
  points             ProjectPoint[]
  observations       Observation[]
  videos             Video[] // Passes vidéo du projet (multi-vidéo : chaque vidéo peut être rattachée à un type d'observation)
  accessList         ProjectAccess[] // Partage ANALYST → ANALYST (par username)
  accessTokens       ObserverAccessToken[] // Liens d'accès observateur (jetons par projet)
  analyticsVersions  AnalyticsVersion[] // Versions analytiques immuables (historique)
  observerInclusions ProjectObserverInclusion[] // Déclassement analytique d'observateurs (INCLUDED/EXCLUDED)
  createdAt          DateTime                   @default(now())
}

/// Passe vidéo d'un projet. Une vidéo peut être rattachée à UN type d'observation
/// (pass « typée » : l'observateur y travaille uniquement ce type) ou rester
/// générique (`typeLabel = null` : l'observateur y capture n'importe quel type
/// proposé — comportement historique du projet à vidéo unique).
model Video {
  id               String                   @id @default(uuid())
  projectId        String
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Libellé exact (issu de Project.observationTypes) auquel cette vidéo est rattachée ; null = vidéo générique.
  typeLabel        String?
  /// Libellé humain affiché (ex. nom de fichier) ; null = généré depuis `source`.
  name             String?
  /// Source de la vidéo (URL distante ou nom de fichier chargé par l'observateur).
  source           String
  /// Ordre d'affichage des onglets dans l'annotateur.
  orderIndex       Int                      @default(0)
  /// Point réel / vérité terrain (en secondes) pour cette passe — CONFIDENTIEL, jamais transmis à l'observateur.
  benchmarkSeconds Int?
  points           ProjectPoint[]
  observations     Observation[]
  partSubmissions  ObserverPartSubmission[]
  createdAt        DateTime                 @default(now())

  @@index([projectId])
}

/// Partage d'un projet (« expérience ») entre analystes (propriétaire + invités).
///
/// RBAC du partage : un invité obtient TOUJOURS la consultation (voir / analyser /
/// exporter). Le droit de MODIFICATION (configuration, types, vidéos, fenêtres,
/// partage, clés observateur) n'est accordé que si `canEdit = true` — c'est-à-dire
/// uniquement quand le partage a explicitement donné un droit d'édition.
model ProjectAccess {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Droit d'édition explicite du partage (false = consultation/analyse/export seuls).
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// VERSION ANALYTIQUE IMMUABLE d'un projet (« expérience »).
///
/// Une version est un INSTANTANÉ figé de l'état analytique : la configuration du
/// périmètre (fenêtres/points, types, passes vidéo) ET les métriques calculées à
/// partir des observations valides disponibles à cet instant (`dataCutoffAt`).
///
/// Règles (jamais violées) :
///  — une version est créée UNIQUEMENT lorsqu'une modification de configuration peut
///    changer le périmètre analytique (ajout/suppression de fenêtre ou de point,
///    modification des types, des passes vidéo…) ;
///  — une nouvelle capture / observation ne crée JAMAIS de version ;
///  — une version déjà écrite n'est JAMAIS recalculée ni mise à jour : aucune
///    fonction de ce dépôt ne met à jour `configuration` ni `metrics` ;
///  — l'« analyse actuelle » n'est pas une ligne de cette table : elle est calculée
///    en direct sur la configuration courante et TOUTES les données valides.
model AnalyticsVersion {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Numéro croissant par projet (1, 2, 3…), attribué à l'écriture.
  versionNumber Int
  /// Instant de figement = borne haute des observations incluses dans les métriques.
  effectiveAt   DateTime @default(now())
  /// Borne haute explicite des données prises en compte (identique à `effectiveAt`).
  dataCutoffAt  DateTime
  /// Cause du figement (ex. WINDOW_ADDED, WINDOW_REMOVED, TYPES_UPDATED, VIDEO_ADDED…).
  trigger       String
  /// `previous` = état analytique JUSTE AVANT la modification de configuration ;
  /// `current`  = état analytique JUSTE APRÈS la modification.
  stage         String
  /// Empreinte stable du périmètre analytique (sert à détecter un vrai changement).
  perimeterHash String
  /// Instantané figé de la configuration (fenêtres, types, passes) — jamais réécrit.
  configuration Json
  /// Instantané figé des métriques analytiques — jamais réécrit.
  metrics       Json
  /// Auteur de la modification de configuration (null si non identifiable).
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([projectId, versionNumber])
  @@index([projectId, effectiveAt])
  @@index([projectId])
}

/// Lien d'accès observateur par projet : un jeton aléatoire à haute entropie (dont seul le
/// hash SHA-256 est persisté dans `tokenHash`) ouvre une session d'observation liée à un seul
/// projet. Le jeton brut n'existe que dans l'URL partagée — jamais en base, jamais dans les
/// journaux. Une session terminée (`COMPLETED`) passe le projet en consultation (lecture seule).
model ObserverAccessToken {
  id                   String                        @id @default(uuid())
  tokenHash            String                        @unique // SHA-256 du jeton brut — le brut n'est jamais stocké
  projectId            String
  project              Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Observateur rattaché à la session (résolu à la première ouverture du lien) ; null tant
  /// que le lien n'a jamais été ouvert.
  observerId           String?
  observer             User?                         @relation(fields: [observerId], references: [id], onDelete: SetNull)
  /// Email du destinataire de l'invitation (affichage admin, déduplication, notifications).
  /// Ce n'est PAS une authentification : le droit d'accès repose sur le token/session.
  observerEmail        String?
  status               ObserverTokenStatus           @default(ACTIVE)
  createdAt            DateTime                      @default(now())
  expiresAt            DateTime? // null = sans expiration
  lastAccessedAt       DateTime?
  completedAt          DateTime?
  revokedAt            DateTime?
  /// Session d'observation logique (runId) stable pour ce lien : la reprise du travail et la
  /// finalisation s'appuient dessus (jamais exposé à l'observateur).
  sessionRunId         String?
  /// États par PARTIE (passe vidéo) de cette session : une partie envoyée est verrouillée
  /// indépendamment des autres, la session globale n'étant clôturée qu'à « Envoyer tout ».
  partSubmissions      ObserverPartSubmission[]
  /// Demandes de réactivation de l'accès (une seule PENDING à la fois par jeton).
  reactivationRequests ObserverReactivationRequest[]

  @@index([projectId])
  @@index([observerId])
  @@index([status])
}

/// DEMANDE DE RÉACTIVATION d'un accès observateur (jeton terminé / désactivé).
///
/// L'observateur crée UNE demande (PENDING) sans jamais réactiver lui-même son accès.
/// Seul un ADMIN confirme (APPROVED → le jeton redevient ACTIVE) ou refuse (REJECTED →
/// l'accès reste tel quel). Les données, parties envoyées et l'historique sont toujours
/// conservés : une réactivation ne supprime ni ne recrée rien.
model ObserverReactivationRequest {
  id          String              @id @default(uuid())
  tokenId     String
  token       ObserverAccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  status      ReactivationStatus  @default(PENDING)
  requestedAt DateTime            @default(now())
  decidedAt   DateTime?
  /// ADMIN ayant statué sur la demande (jamais l'observateur).
  decidedById String?
  decidedBy   User?               @relation("ReactivationDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())

  @@index([tokenId])
  @@index([status])
}

/// ÉTAT PAR PARTIE d'une session d'observation (lien par projet).
///
/// Une « partie » = une passe vidéo (`videoId`) ou la passe générique héritée
/// (`videoId = null`). Chaque partie a son propre statut : NOT_STARTED, IN_PROGRESS,
/// ou SUBMITTED. « Envoyer cette partie » finalise la partie visée (ses captures
/// deviennent certifiées) SANS clôturer la session ; « Envoyer tout » finalise les
/// parties restantes puis clôture la session (le jeton passe COMPLETED).
///
/// La base est la source de vérité : une partie SUBMITTED refuse toute nouvelle
/// capture / modification / suppression, mais n'invalide pas le jeton — l'observateur
/// reprend normalement les parties encore ouvertes.
model ObserverPartSubmission {
  id          String              @id @default(uuid())
  tokenId     String
  token       ObserverAccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// Passe vidéo cible ; null = passe générique héritée (projet à vidéo unique).
  videoId     String?
  video       Video?              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status      ObserverPartStatus  @default(NOT_STARTED)
  submittedAt DateTime?
  createdAt   DateTime            @default(now())

  @@index([tokenId])
  @@index([tokenId, videoId])
}

/// DÉCLASSEMENT D'UN OBSERVATEUR dans les analyses d'UN PROJET.
///
/// ADDITIF et non destructif : l'ABSENCE de ligne vaut INCLUDED, donc les données
/// existantes n'ont besoin d'AUCUN backfill et restent strictement inchangées.
/// Une ligne n'est créée que lorsqu'un ADMIN déclasse (ou re-classe) explicitement.
///
/// `EXCLUDED` ⇒ le moteur analytique courant ignore les observations de cet
/// observateur (numérateur ET dénominateur : le nombre analytique d'observateurs
/// diminue d'autant). `INCLUDED` ⇒ ses observations recomptent immédiatement.
/// Aucune suppression n'est jamais effectuée — les captures restent consultables
/// pour l'audit et l'historique.
model ProjectObserverInclusion {
  id              String                 @id @default(uuid())
  projectId       String
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation("ObserverInclusionSubject", fields: [userId], references: [id], onDelete: Cascade)
  status          ObserverAnalysisStatus @default(INCLUDED)
  /// Horodatage du déclassement (null tant que l'observateur n'a jamais été exclu).
  excludedAt      DateTime?
  /// ADMIN ayant prononcé le déclassement.
  excludedById    String?
  excludedBy      User?                  @relation("ObserverExclusionDecidedBy", fields: [excludedById], references: [id], onDelete: SetNull)
  /// Motif scientifique du déclassement (données biaisées, protocole non conforme…).
  exclusionReason String?
  /// Horodatage de la dernière ré-inclusion.
  includedAt      DateTime?
  /// ADMIN ayant rétabli l'observateur.
  includedById    String?
  includedBy      User?                  @relation("ObserverInclusionDecidedBy", fields: [includedById], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt

  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId])
}

model ProjectPoint {
  id           String        @id @default(uuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoId      String? // Fenêtre rattachée à une passe vidéo précise ; null = fenêtre « générique » (projet à vidéo unique)
  video        Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  pointName    String // ex: "Point 2"
  trameDebut   Int // Trame début en secondes
  trameFin     Int // Trame fin en secondes
  observations Observation[]

  @@index([projectId])
  @@index([videoId])
}

model Observation {
  id              String        @id @default(uuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId         String? // Passe vidéo d'origine ; null = vidéo générique historique
  video           Video?        @relation(fields: [videoId], references: [id], onDelete: SetNull)
  pointId         String? // Auto-assigné si dans [trameDebut, trameFin]
  point           ProjectPoint? @relation(fields: [pointId], references: [id], onDelete: SetNull)
  timestampTotal  Int // Horodatage saisi en secondes
  imageUrl        String // URL publique d'accès à la capture annotée (CDN/Drive)
  /// Identifiant Cloudinary (public_id) historique — lignes antérieures à la migration
  /// Google Drive. Conservé en lecture seule ; les nouvelles captures utilisent `driveFileId`.
  imagePublicId   String?
  /// Identifiant Google Drive (fileId) de la capture annotée (stockage des nouvelles
  /// captures). Jamais exposé à l'observateur : usage serveur interne (suppression ciblée,
  /// lecture pour les exports serveur).
  driveFileId     String?
  observationType String? // Type d'observation choisi par l'observateur (issu de Project.observationTypes)
  isGhostPoint    Boolean       @default(false) // Indique si hors-trame / fausse alerte
  /// Vrai ⇒ capture « certifiée » (session finalisée), seule donnée comptée dans les
  /// statistiques/exports. Faux ⇒ capture enregistrée immédiatement mais dont la session
  /// n'est pas encore finalisée (donnée transitoire, invisible des analyses).
  isVerified      Boolean       @default(true)
  /// Jeton de « session » logique (une soumission, toutes passes confondues) — sert au
  /// comptage de sessions par observateur et à la traçabilité (jamais exposé à l'observateur).
  sessionRunId    String?
  /// Clé de déduplication émise par le client, stable pour une capture donnée (son `id`
  /// local). Le couple (projet, clé) est unique : re-soumettre une capture déjà enregistrée
  /// est sans effet (idempotence locale + reprise après échec partiel).
  clientKey       String?
  createdAt       DateTime      @default(now())

  @@unique([projectId, clientKey])
  @@index([projectId])
  @@index([userId])
  @@index([pointId])
  @@index([videoId])
}
