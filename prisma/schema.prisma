datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ANALYST
  OBSERVER
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String?         @unique // Pseudonyme d'analyse (login lisible)
  password      String
  role          Role            @default(OBSERVER)
  isActive      Boolean         @default(true) // Compte désactivable par un administrateur
  anonymousId   String          @unique @default(uuid())
  observations  Observation[]
  ownedProjects Project[]       @relation("ProjectOwner")
  grantedAccess ProjectAccess[]
  createdAt     DateTime        @default(now())
}

model Project {
  id           String          @id @default(uuid())
  ownerId      String? // Créateur (ADMIN ou ANALYST) — null pour les projets hérités
  owner        User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  videoUrl     String?         // Chemin ou nom du fichier vidéo local
  isArchived   Boolean         @default(false)
  points       ProjectPoint[]
  observations Observation[]
  accessList   ProjectAccess[] // Partage ANALYST → ANALYST (par username)
  createdAt    DateTime        @default(now())
}

/// Partage d'un projet entre analystes (propriétaire + invités).
model ProjectAccess {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectPoint {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pointName      String        // ex: "Point 2"
  trameDebut     Int           // Trame début en secondes
  trameFin       Int           // Trame fin en secondes
  observations   Observation[]

  @@index([projectId])
}

model Observation {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointId        String?       // Auto-assigné si dans [trameDebut, trameFin]
  point          ProjectPoint? @relation(fields: [pointId], references: [id], onDelete: SetNull)
  timestampTotal Int           // Horodatage saisi en secondes
  imageUrl       String        // URL Cloudinary de la capture annotée
  isGhostPoint   Boolean       @default(false) // Indique si hors-trame / fausse alerte
  isVerified     Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([pointId])
}